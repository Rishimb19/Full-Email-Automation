# Server
PORT=3001

# Database
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Bcrypt
BCRYPT_ROUNDS=10

# Groq AI
GROQ_API_KEY="your-actual-key-here"  # Replace with dummy value

# Google OAuth (SAME credentials for both Sign-In and Gmail Send)
GOOGLE_CLIENT_ID="your-client-id"     # Replace with dummy value
GOOGLE_CLIENT_SECRET="your-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/gmail-callback"